PORT=5000
MONGODB_URI=mongodb://localhost:27017/chatboot

# WhatsApp Business API (Meta - still needed for messaging platform)
WHATSAPP_VERIFY_TOKEN=your_verify_token
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_id

# ─── LOCAL AI SERVICES (No external APIs) ────────────────────────────────────
# Ollama local LLM
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=aya:8b

# Local Whisper (nodejs-whisper wraps whisper.cpp)
WHISPER_MODEL=base   # Options: tiny, base, small, medium

# Piper TTS (local binary - installed on EC2)
PIPER_BINARY=/usr/local/bin/piper
PIPER_MODEL_FR=/opt/piper/models/fr_FR-siwis-medium.onnx
PIPER_MODEL_AR=/opt/piper/models/ar_JO-kareem-medium.onnx
